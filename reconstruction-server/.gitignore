# ==========================================================
# HAMMER CRAFT
# .gitignore
# ==========================================================


# ----------------------------------------------------------
# SECRETS / ENVIRONMENT VARIABLES
# NEVER COMMIT THESE
# ----------------------------------------------------------

.env
.env.*
**/.env
**/.env.*

# Allow example environment files if we create one later
!.env.example
!**/.env.example


# ----------------------------------------------------------
# SECRET / PRIVATE KEY FILES
# ----------------------------------------------------------

*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

secrets/
**/secrets/

credentials/
**/credentials/


# ----------------------------------------------------------
# RECONSTRUCTION SERVER - PYTHON ENVIRONMENT
# ----------------------------------------------------------

.venv/
**/.venv/

venv/
**/venv/

env/
**/env/

ENV/
**/ENV/


# ----------------------------------------------------------
# PYTHON CACHE / GENERATED FILES
# ----------------------------------------------------------

__pycache__/
**/__pycache__/

*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/

.coverage
coverage.xml
htmlcov/


# ----------------------------------------------------------
# PYTHON BUILD FILES
# ----------------------------------------------------------

build/
dist/
downloads/
eggs/
.eggs/

*.egg-info/
*.egg

pip-wheel-metadata/


# ----------------------------------------------------------
# HAMMER CRAFT RECONSTRUCTION TEMPORARY FILES
# ----------------------------------------------------------

reconstruction-server/work/
reconstruction-server/temp/
reconstruction-server/tmp/
reconstruction-server/cache/
reconstruction-server/logs/

# COLMAP temporary reconstruction data
**/database.db
**/database.db-shm
**/database.db-wal

**/sparse/
**/dense/

**/fused.ply
**/raw-mesh.ply


# ----------------------------------------------------------
# GENERATED CUSTOMER SCAN DATA
#
# Customer ear images / meshes should live in Supabase,
# NOT inside the GitHub repository.
# ----------------------------------------------------------

reconstruction-server/scans/
reconstruction-server/uploads/
reconstruction-server/downloads/
reconstruction-server/results/

**/customer-scans/
**/ear-images/


# ----------------------------------------------------------
# GENERATED 3D FILES
#
# Prevent accidentally committing customer ear geometry.
# ----------------------------------------------------------

reconstruction-server/**/*.stl
reconstruction-server/**/*.ply
reconstruction-server/**/*.obj
reconstruction-server/**/*.glb
reconstruction-server/**/*.gltf


# ----------------------------------------------------------
# LOG FILES
# ----------------------------------------------------------

*.log
logs/
**/logs/


# ----------------------------------------------------------
# NODE / NPM
# Keep these in case we add Node tooling later.
# ----------------------------------------------------------

node_modules/
**/node_modules/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.npm/
.yarn/


# ----------------------------------------------------------
# NEXT.JS / VITE / FRONTEND BUILD FILES
# Not currently required for GitHub Pages,
# but safe to ignore if added later.
# ----------------------------------------------------------

.next/
out/
.nuxt/
.vite/

.cache/
.parcel-cache/


# ----------------------------------------------------------
# MACOS
# ----------------------------------------------------------

.DS_Store
**/.DS_Store

.AppleDouble
.LSOverride

Icon

._*


# ----------------------------------------------------------
# WINDOWS
# ----------------------------------------------------------

Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini


# ----------------------------------------------------------
# VS CODE
# ----------------------------------------------------------

.vscode/

# If you later want shared VS Code settings,
# remove the line above and use selective rules instead.


# ----------------------------------------------------------
# JETBRAINS
# ----------------------------------------------------------

.idea/
*.iml


# ----------------------------------------------------------
# XCODE
#
# You abandoned the native iOS scanner, but these prevent
# generated Xcode files being committed accidentally.
# ----------------------------------------------------------

DerivedData/
*.xcuserstate

xcuserdata/
**/xcuserdata/

*.xcscmblueprint
*.xccheckout


# ----------------------------------------------------------
# SWIFT
# ----------------------------------------------------------

.build/
Packages/
Package.resolved


# ----------------------------------------------------------
# TEMPORARY / BACKUP FILES
# ----------------------------------------------------------

*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo

*~
~$*


# ----------------------------------------------------------
# ARCHIVES
# ----------------------------------------------------------

*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar


# ----------------------------------------------------------
# LOCAL DEVELOPMENT
# ----------------------------------------------------------

.local/
.localhost/

.env.local
.env.development.local
.env.test.local
.env.production.local


# ----------------------------------------------------------
# RESEND / API SECRETS
# ----------------------------------------------------------

# These should already be covered by .env rules,
# but explicitly ignore common local secret files.

resend.env
supabase.env
server.env
secrets.env


# ----------------------------------------------------------
# HAMMER CRAFT LOCAL ADMIN FILES
# ----------------------------------------------------------

admin-secrets.json
credentials.json
service-account.json